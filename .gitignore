# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

!Build/BatchFiles/*

# Don't ignore icon files in Build
!Build/**/*.ico

# UGP Android port: project Java sources MUST be versioned. The UE template's
# Build/*/** rule hides Build/Android/src/** entirely, which would drop the
# patcher Activity from the repo (it is compiled by gradle at packaging time).
!Build/Android/src/
!Build/Android/src/com/
!Build/Android/src/com/epicgames/
!Build/Android/src/com/epicgames/unreal/
!Build/Android/src/com/epicgames/unreal/patch/
!Build/Android/src/com/epicgames/unreal/patch/**

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# IoStoreServer - MinIO binaries and data
IoStoreServer/minio.exe
IoStoreServer/mc.exe
IoStoreServer/Data/

# Build outputs
Archives/

# Local edit backups and tool caches (AGENTS.md backup convention)
*.bak*
__pycache__/

# IDE / agent workspace files
.idea/
.vscode/
.claude/
.zcode/

# Visual Studio local cache
.vs/

# Hand-written mini solution for UGP debug workflow (DEBUGGER.md)
!Tools/VSDebug/UGPDebugOnly.sln

# UGP: fixture is rebuilt per machine from a real packaging run (see
# Source/Programs/UnrealGamePatcher/Docs/TESTCASES.md - 依赖与数据)
.manifesttest/

# UGP: third-party S3 server binaries are machine-local (see
# Source/Programs/UnrealGamePatcher/Scripts/start_rustfs.* header)
Source/Programs/UnrealGamePatcher/Scripts/rustfs
Source/Programs/UnrealGamePatcher/Scripts/rustfs.exe

# UGP Android: libugp.so 是构建产物（Binaries/Android/UnrealGamePatcherLib-arm64.so 的拷贝），
# 不入库；打包前见 Docs/android-s1-runbook.md §二 第 1 步
Plugins/UGPAndroidPatch/Source/UGPAndroidPatch/libs/
